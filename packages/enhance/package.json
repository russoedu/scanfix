{
  "name": "@scanmate/enhance",
  "version": "0.0.1",
  "description": "Clean scans for reading: even lighting, lighter paper, darker ink, speckle removed - enlarged to 300 dpi for OCR.",
  "license": "MIT",
  "author": "Eduardo Russo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russoedu/scanmate.git",
    "directory": "packages/enhance"
  },
  "homepage": "https://github.com/russoedu/scanmate/tree/main/packages/enhance#readme",
  "bugs": {
    "url": "https://github.com/russoedu/scanmate/issues"
  },
  "keywords": [
    "scan",
    "enhance",
    "ocr",
    "preprocessing",
    "despeckle",
    "document"
  ],
  "type": "module",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map",
    "!**/*.js.map"
  ],
  "dependencies": {
    "@scanmate/ink": "^0.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
