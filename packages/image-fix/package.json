{
  "name": "@scanmate/image-fix",
  "version": "0.0.1",
  "description": "Deprecated: forwards to @scanmate/align, @scanmate/diff and @scanmate/ink. Align a scanned or photographed page onto the original it came from, and report which known regions gained ink.",
  "keywords": [
    "scan",
    "alignment",
    "image-registration",
    "document",
    "ocr",
    "deskew",
    "homography",
    "orb",
    "ransac",
    "pdf",
    "signature-detection",
    "azure-functions"
  ],
  "license": "MIT",
  "author": "Eduardo Russo",
  "homepage": "https://github.com/russoedu/scanfix/tree/main/packages/image-fix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russoedu/scanfix.git",
    "directory": "packages/image-fix"
  },
  "bugs": {
    "url": "https://github.com/russoedu/scanfix/issues"
  },
  "type": "module",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node tools/declaration-extensions.cjs"
  },
  "dependencies": {
    "@scanmate/align": "^0.0.1",
    "@scanmate/diff": "^0.0.1",
    "@scanmate/ink": "^0.0.1"
  }
}
