{
  "name": "@scanmate/ink",
  "version": "0.0.1",
  "description": "The pixel and geometry kernel behind ScanMate: raster codec, ink separation, warps, homographies, FFT and the pipeline contracts.",
  "license": "MIT",
  "author": "Eduardo Russo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russoedu/scanmate.git",
    "directory": "packages/ink"
  },
  "homepage": "https://github.com/russoedu/scanmate/tree/main/packages/ink#readme",
  "bugs": {
    "url": "https://github.com/russoedu/scanmate/issues"
  },
  "keywords": [
    "scan",
    "image-processing",
    "raster",
    "homography",
    "fft",
    "document"
  ],
  "type": "module",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
